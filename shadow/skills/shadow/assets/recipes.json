{
  "schema_version": 1,
  "language": "zh-CN",
  "purpose": "按主要目标提供可覆盖的剪辑起点，减少从零构思；配方选择不替代看素材、试听和用户要求。",
  "selection_policy": {
    "method": "query_tags 关键词候选匹配，再按 priority_signal 与真实素材核对",
    "fallback_recipe": "general-story",
    "confidence_note": "关键词匹配是暂定路由，不是语义理解、素材内容识别或用户意图确认。命中多个配方时按主导目标选一个，其余只补必要技巧。",
    "user_spec_precedence": true,
    "start_with_core_only": true,
    "optional_technique_hint": "每次只加几个能说明用途的技巧；数目不是限制。",
    "parameters_are": "heuristic_starting_points_not_requirements",
    "read_references": "只读所选工作流及引用技巧；Premiere 交付时再读 premiere.md。"
  },
  "implementation_levels": {
    "core_hard_cut": "可用基础入出点和硬切时间线表达；支持情况仍按实际脚本验证，不能推断自动选镜或原声联动。",
    "editorial_plan": "人工/AI看素材与试听后提出决策，计划本身不等于执行效果。",
    "premiere_manual": "Premiere 原生可实现，当前基础脚本不自动执行。",
    "conditional_preprocess": "只在对应脚本、依赖、参数与结果测试都确认时报告实际完成。",
    "shadow_v2": "shadow.py v2 执行转场、透明标题字幕、静态图与视频渲染；PR 交接方式见报告。",
    "local_asr": "subtitles.py 真实本地音频识别和文稿校正，输出时间戳/SRT/复核报告。"
  },
