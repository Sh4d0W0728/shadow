  "recipes": [
    {
      "id": "mv-lyrics",
      "name": "歌词驱动 MV",
      "query_tags": [
        "歌词",
        "歌词MV",
        "歌词 mv",
        "抒情MV",
        "抒情 mv",
        "音乐MV",
        "音乐 mv",
        "LRC",
        "lyric",
        "lyrics",
        "音乐录影带",
        "歌曲叙事"
      ],
      "priority_signal": "歌词含义、歌曲情绪或意象是主要目标；只出现 MV 一词不足以确定是歌词驱动。",
      "core_techniques": [
        "S01",
        "R01",
        "R05",
        "R08",
        "T05"
      ],
      "optional_techniques": [
        "R02",
        "R04",
        "C03",
        "V05",
        "T01"
      ],
      "structure": [
        "核对实际音频和歌词",
        "按真实乐段写情绪功能",
        "用少量意象建立呼应",
        "在情绪落点停留",
        "按歌曲尾奏收束"
      ],
      "pacing_defaults": {
        "unit": "lyric_phrase_or_musical_phrase",
        "shot_seconds_hint": [
          2,
          6
        ],
        "emotional_hold_seconds_hint": [
          4,
          8
        ],
        "pilot_seconds_hint": [
          15,
          30
        ],
        "note": "乐句、歌词与动作优先；不按固定秒数截句。"
      },
      "audio_defaults": {
        "primary": "当前指定歌曲的实际可用音频",
        "speech_priority": "only_if_requested_or_story_requires",
        "auto_ducking": false,
        "loudness_target_lufs": null,
        "note": "存在歌词文件不等于要求烧录字幕；无完整音频不能报告完整 MV。"
      },
      "output_defaults": {
        "duration": "用户指定范围，否则实际歌曲范围",
        "aspect_ratio": "user_spec_else_existing_sequence",
        "fps": "user_spec_else_existing_sequence_else_source_appropriate",
        "premiere_handoff": "verified_supported_xmeml_plus_manual_finish_list",
        "baked_captions": false
      },
      "avoid": [
        "套用以前的歌曲、角色或比例",
        "逐字找物件而失去情绪",
        "每拍都切",
        "把歌词字幕计划称作已实现字幕"
      ],
      "verification": [
        "歌曲/歌手/音频/歌词/工程/导出身份相符",
        "指定音频范围完整",
        "情绪段落有变化",
        "歌词时间和含义正确",
        "参数实测"
      ]
    },
